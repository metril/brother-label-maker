          "minimum": 1,
          "title": "N Blocks",
          "type": "integer"
        },
        "block_type": {
          "default": "4-pair",
          "enum": [
            "4-pair",
            "3-pair",
            "2-pair",
            "5-pair",
            "blank"
          ],
          "title": "Block Type",
          "type": "string"
        },
        "sequence": {
          "default": "horizontal",
          "enum": [
            "none",
            "horizontal",
            "backbone"
          ],
          "title": "Sequence",
          "type": "string"
        },
        "start_value": {
          "default": 1,
          "maximum": 99999,
          "minimum": 1,
          "title": "Start Value",
          "type": "integer"
        },
        "extra_lines": {
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "title": "Extra Lines",
          "type": "array"
        },
        "font_family": {
          "default": "Inter",
          "title": "Font Family",
          "type": "string"
        },
        "bold": {
          "default": false,
          "title": "Bold",
          "type": "boolean"
        },
        "font_size_px": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Size Px"
        },
        "padding_mm": {
          "default": 1,
          "minimum": 0,
          "title": "Padding Mm",
          "type": "number"
        }
      },
      "title": "PunchDownParams",
      "type": "object"
    }
  },
