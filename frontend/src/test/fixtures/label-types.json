[
  {
    "type": "text",
    "title": "Text",
    "category": "general",
    "min_tape_mm": null,
    "params_schema": {
      "$defs": {
        "ImageIcon": {
          "properties": {
            "kind": {
              "const": "image",
              "default": "image",
              "title": "Kind",
              "type": "string"
            },
            "image_id": {
              "description": "an image_id returned by POST /api/images",
              "title": "Image Id",
              "type": "string"
            },
            "mode": {
              "default": "threshold",
              "description": "threshold: binarized at a fixed cutoff, hard edges; dither: Floyd-Steinberg halftone (better for photos/gradients)",
              "enum": [
                "threshold",
                "dither"
              ],
              "title": "Mode",
              "type": "string"
            },
            "threshold": {
              "default": 128,
              "description": "threshold mode's cutoff (0-255)",
              "maximum": 255,
              "minimum": 0,
              "title": "Threshold",
              "type": "integer"
            }
          },
          "required": [
            "image_id"
          ],
          "title": "ImageIcon",
          "type": "object"
        },
        "SymbolIcon": {
          "properties": {
            "kind": {
              "const": "symbol",
              "default": "symbol",
              "title": "Kind",
              "type": "string"
            },
            "id": {
              "description": "a symbol id from GET /api/symbols",
              "title": "Id",
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "title": "SymbolIcon",
          "type": "object"
        }
      },
      "properties": {
        "lines": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Lines",
          "type": "array"
        },
        "font_family": {
          "default": "Inter",
          "title": "Font Family",
          "type": "string"
        },
        "bold": {
          "default": false,
          "title": "Bold",
          "type": "boolean"
        },
        "font_size_px": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Size Px"
        },
        "h_align": {
          "default": "center",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "title": "H Align",
          "type": "string"
        },
        "length_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Mm"
        },
        "padding_mm": {
          "default": 2,
          "minimum": 0,
          "title": "Padding Mm",
          "type": "number"
        },
        "icon": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "image": "#/$defs/ImageIcon",
                  "symbol": "#/$defs/SymbolIcon"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/SymbolIcon"
                },
                {
                  "$ref": "#/$defs/ImageIcon"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "optional leading art at the left of the text block, square, sized to (print height - 2*padding); text shifts right to make room",
          "title": "Icon"
        }
      },
      "required": [
        "lines"
      ],
      "title": "TextLabelParams",
      "type": "object"
    }
  },
  {
    "type": "barcode",
    "title": "Barcode",
    "category": "general",
    "min_tape_mm": null,
    "params_schema": {
      "properties": {
        "symbology": {
          "default": "qr",
          "description": "which barcode type to encode data as",
          "enum": [
            "qr",
            "code128",
            "code39",
            "datamatrix"
          ],
          "title": "Symbology",
          "type": "string"
        },
        "data": {
          "description": "the value encoded in the code (also the caption text, when shown)",
          "maxLength": 500,
          "minLength": 1,
          "title": "Data",
          "type": "string"
        },
        "caption": {
          "default": "below",
          "description": "show the encoded data as text under the code, or not",
          "enum": [
            "none",
            "below"
          ],
          "title": "Caption",
          "type": "string"
        },
        "size_mode": {
          "default": "auto",
          "description": "auto: largest module size that fits the tape (2D) / stretch to fill height (1D); module: use module_px, clamped down if it would overflow",
          "enum": [
            "auto",
            "module"
          ],
          "title": "Size Mode",
          "type": "string"
        },
        "module_px": {
          "default": 2,
          "description": "module size in px (QR/DataMatrix) or bar x-dimension (Code128/Code39); used directly when size_mode='module' (clamped if too large to fit the tape), and always for 1D x-dimension",
          "maximum": 20,
          "minimum": 1,
          "title": "Module Px",
          "type": "integer"
        },
        "length_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "fixed label length in mm; omit for auto (content-fit) width",
          "title": "Length Mm"
        },
        "font_family": {
          "default": "Inter",
          "description": "caption font family name (see GET /api/fonts)",
          "title": "Font Family",
          "type": "string"
        },
        "bold": {
          "default": false,
          "description": "bold caption text weight",
          "title": "Bold",
          "type": "boolean"
        },
        "padding_mm": {
          "default": 2,
          "description": "content padding on the left/right of the code",
          "minimum": 0,
          "title": "Padding Mm",
          "type": "number"
        }
      },
      "required": [
        "data"
      ],
      "title": "BarcodeLabelParams",
      "type": "object"
    }
  },
  {
    "type": "patch_panel",
    "title": "Patch Panel",
    "category": "network",
    "min_tape_mm": null,
    "params_schema": {
      "$defs": {
        "BlockText": {
          "properties": {
            "lines": {
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "title": "Lines",
              "type": "array"
            }
          },
          "title": "BlockText",
          "type": "object"
        },
        "Orientation": {
          "enum": [
            "horizontal",
            "vertical",
            "backbone"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "Separator": {
          "enum": [
            "tic",
            "dash",
            "line",
            "bold",
            "frame",
            "none"
          ],
          "title": "Separator",
          "type": "string"
        }
      },
      "properties": {
        "block_length_mm": {
          "default": 15,
          "maximum": 300,
          "minimum": 5,
          "title": "Block Length Mm",
          "type": "number"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/BlockText"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        },
        "separator": {
          "$ref": "#/$defs/Separator",
          "default": "line"
        },
        "orientation": {
          "$ref": "#/$defs/Orientation",
          "default": "horizontal"
        },
        "reverse": {
          "default": false,
          "title": "Reverse",
          "type": "boolean"
        },
        "multipliers": {
          "anyOf": [
            {
              "items": {
                "maximum": 9.5,
                "minimum": 0.1,
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Multipliers"
        },
        "font_family": {
          "default": "Inter",
          "title": "Font Family",
          "type": "string"
        },
        "bold": {
          "default": false,
          "title": "Bold",
          "type": "boolean"
        },
        "font_size_px": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Size Px"
        },
        "padding_mm": {
          "default": 1,
          "minimum": 0,
          "title": "Padding Mm",
          "type": "number"
        }
      },
      "required": [
        "blocks"
      ],
      "title": "PatchPanelParams",
      "type": "object"
    }
  },
  {
    "type": "punch_down",
    "title": "Punch-Down Block",
    "category": "network",
