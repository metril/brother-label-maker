  {
    "type": "cable_wrap",
    "title": "Cable Wrap",
    "category": "network",
    "min_tape_mm": null,
    "params_schema": {
      "properties": {
        "cable_diameter_mm": {
          "default": 6,
          "description": "cable diameter in mm (3-90); label length is derived from this as circumference (pi * diameter) plus overlap_mm. TZe-FX Flexible ID tape or TZe-SL Self-Laminating tape is recommended for cable-wrap applications.",
          "maximum": 90,
          "minimum": 3,
          "title": "Cable Diameter Mm",
          "type": "number"
        },
        "overlap_mm": {
          "default": 5,
          "description": "extra length beyond the cable's own circumference so the two wrapped ends overlap and stick to each other (Brother's spec requires >= 5mm)",
          "maximum": 20,
          "minimum": 5,
          "title": "Overlap Mm",
          "type": "number"
        },
        "lines": {
          "description": "1-2 lines of text, each <= 30 chars; at least one must be non-empty",
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Lines",
          "type": "array"
        },
        "repeat": {
          "default": true,
          "description": "repeat the text as many times as fit around the wrap with >= 2mm gaps; False prints a single instance centered on the label",
          "title": "Repeat",
          "type": "boolean"
        },
        "font_family": {
          "default": "Inter",
          "description": "font family name (see GET /api/fonts)",
          "title": "Font Family",
          "type": "string"
        },
        "bold": {
          "default": false,
          "description": "bold text weight",
          "title": "Bold",
          "type": "boolean"
        },
        "font_size_px": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "fixed font size in px; omit for auto-fit",
          "title": "Font Size Px"
        },
        "padding_mm": {
          "default": 1,
          "description": "inner text padding, applied both across the tape and along its length",
          "minimum": 0,
          "title": "Padding Mm",
          "type": "number"
        }
      },
      "required": [
        "lines"
      ],
      "title": "CableWrapParams",
      "type": "object"
    }
  },
  {
    "type": "cable_flag",
    "title": "Cable Flag",
    "category": "network",
    "min_tape_mm": null,
    "params_schema": {
      "properties": {
        "cable_diameter_mm": {
          "default": 4,
          "description": "cable diameter in mm (3-90); sizes the blank gap between the two printed flag ends so it wraps the cable with a little slack",
          "maximum": 90,
          "minimum": 3,
          "title": "Cable Diameter Mm",
          "type": "number"
        },
        "flag_length_mm": {
          "default": 20,
          "description": "length in mm of EACH printed flag end (both ends share this length)",
          "maximum": 100,
          "minimum": 5,
          "title": "Flag Length Mm",
          "type": "number"
        },
        "lines": {
          "description": "1-2 lines of text, each <= 30 chars; at least one must be non-empty",
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Lines",
          "type": "array"
        },
        "text_orientation": {
          "default": "horizontal",
          "description": "horizontal: text reads along the flag; vertical: text reads across the tape (rotated 90/270 -- see module docstring)",
          "enum": [
            "horizontal",
            "vertical"
          ],
          "title": "Text Orientation",
          "type": "string"
        },
        "font_family": {
          "default": "Inter",
          "description": "font family name (see GET /api/fonts)",
          "title": "Font Family",
          "type": "string"
        },
        "bold": {
          "default": false,
          "description": "bold text weight",
          "title": "Bold",
          "type": "boolean"
        },
        "font_size_px": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "fixed font size in px; omit for auto-fit",
          "title": "Font Size Px"
        },
        "padding_mm": {
          "default": 1,
          "description": "inner text padding on every side of each flag end",
          "minimum": 0,
          "title": "Padding Mm",
          "type": "number"
        }
      },
      "required": [
        "lines"
      ],
      "title": "CableFlagParams",
      "type": "object"
    }
  },
  {
    "type": "terminal_block",
    "title": "Terminal Block",
    "category": "electrical",
    "min_tape_mm": null,
    "params_schema": {
      "$defs": {
        "Separator": {
          "enum": [
            "tic",
            "dash",
            "line",
            "bold",
            "frame",
            "none"
          ],
          "title": "Separator",
          "type": "string"
        }
      },
      "properties": {
        "pitch_mm": {
          "default": 6,
          "description": "center-to-center terminal width",
          "maximum": 50,
          "minimum": 3,
          "title": "Pitch Mm",
          "type": "number"
        },
        "n_terminals": {
          "default": 12,
          "description": "number of terminals on the strip -- one block per terminal",
          "maximum": 50,
          "minimum": 1,
          "title": "N Terminals",
          "type": "integer"
        },
        "numbering": {
          "default": true,
          "description": "auto-number every terminal that isn't overridden by `labels`; when False, an unlabeled terminal renders blank",
          "title": "Numbering",
          "type": "boolean"
        },
        "start_value": {
          "default": 1,
          "description": "number shown on terminal 0 when numbering is on",
          "maximum": 99999,
          "minimum": 0,
          "title": "Start Value",
          "type": "integer"
        },
        "step": {
          "default": 1,
          "description": "increment between consecutive terminals' numbers",
          "maximum": 100,
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        },
        "labels": {
          "description": "per-terminal text overrides, by position (entry i replaces terminal i's number); shorter than n_terminals leaves the rest numbered",
          "items": {
            "maxLength": 20,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Labels",
          "type": "array"
        },
        "orientation": {
          "default": "vertical",
          "description": "text direction: vertical (default -- narrow strip) or horizontal",
          "enum": [
            "horizontal",
            "vertical"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "separator": {
          "$ref": "#/$defs/Separator",
          "default": "line",
          "description": "mark drawn on each terminal boundary"
        },
        "font_family": {
          "default": "Inter",
          "description": "font family name (see GET /api/fonts)",
          "title": "Font Family",
          "type": "string"
        },
        "bold": {
          "default": false,
          "description": "bold text weight",
          "title": "Bold",
          "type": "boolean"
        },
        "font_size_px": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "fixed font size in px; omit for auto-fit",
          "title": "Font Size Px"
        },
        "padding_mm": {
          "default": 1,
          "description": "inner text padding on every side of each block",
          "minimum": 0,
          "title": "Padding Mm",
          "type": "number"
        }
      },
      "title": "TerminalBlockParams",
      "type": "object"
    }
  },
  {
    "type": "breaker_box",
    "title": "Breaker Box",
    "category": "electrical",
    "min_tape_mm": null,
    "params_schema": {
      "$defs": {
        "BreakerSpec": {
          "properties": {
            "poles": {
              "default": 1,
              "description": "breaker width in panel positions (2 = double-pole)",
              "maximum": 4,
              "minimum": 1,
              "title": "Poles",
              "type": "integer"
            },
            "lines": {
              "description": "circuit description under the number",
              "items": {
                "maxLength": 30,
                "type": "string"
              },
              "maxItems": 2,
              "title": "Lines",
              "type": "array"
            }
          },
          "title": "BreakerSpec",
          "type": "object"
        },
        "Separator": {
          "enum": [
            "tic",
            "dash",
            "line",
            "bold",
            "frame",
            "none"
          ],
          "title": "Separator",
          "type": "string"
        }
      },
      "properties": {
        "pitch_mm": {
          "default": 25.4,
          "description": "width of one panel position (1in standard, 12.7mm half-size)",
          "maximum": 60,
          "minimum": 10,
          "title": "Pitch Mm",
          "type": "number"
        },
        "breakers": {
          "description": "breakers left-to-right, in panel order",
          "items": {
            "$ref": "#/$defs/BreakerSpec"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Breakers",
          "type": "array"
        },
        "numbering_scheme": {
          "default": "sequential",
          "description": "sequential 1,2,3...; odd = left panel column 1,3,5...; even = right column 2,4,6...",
          "enum": [
            "sequential",
            "odd",
            "even"
          ],
          "title": "Numbering Scheme",
          "type": "string"
        },
        "start_value": {
          "default": 1,
          "description": "slot number of the first breaker's first position -- must be odd for numbering_scheme='odd', even for 'even'",
          "maximum": 999,
          "minimum": 1,
          "title": "Start Value",
          "type": "integer"
        },
        "show_numbers": {
          "default": true,
          "description": "prepend the computed panel-position number to each breaker's text",
          "title": "Show Numbers",
          "type": "boolean"
        },
        "separator": {
          "$ref": "#/$defs/Separator",
          "default": "line",
          "description": "mark drawn on each breaker boundary"
        },
        "font_family": {
          "default": "Inter",
          "description": "font family name (see GET /api/fonts)",
          "title": "Font Family",
          "type": "string"
        },
        "bold": {
          "default": false,
          "description": "bold text weight",
          "title": "Bold",
          "type": "boolean"
        },
        "font_size_px": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
